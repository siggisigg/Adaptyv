%% file: er-full
erDiagram
    storage_unit_kinds ||--o{ storage_unit : "kind of"
    storage_unit |o--o{ storage_unit : "stored_in (nesting)"
    storage_unit ||--o{ vessel : "holds"
    storage_unit ||--o{ stock : "holds"
    stock |o--o{ storage_unit : "from_stock (plate made from stock)"
    stock |o--o{ vessel : "from_stock"
    vessel ||--o{ items : "contains"
    materials ||--o{ items : "category"
    materials ||--o{ lots : "category"
    lots |o--o{ items : "lot_id (bought items)"
    lots |o--o{ stock : "lot_id"
    units ||--o{ items : "unit"
    items ||--o{ item_lineage : "parent_item"
    items ||--o{ item_lineage : "child_item"
    users |o--o{ item_lineage : "created_by"
    users |o--o{ transfer_batches : "requested_by"
    transfer_batches ||--o{ transfer_batch_lines : "lines (raw request, no FKs)"
    users |o--o{ audit_log : "changed_by"

    users {
        INT id PK
        TEXT username
    }
    transfer_batches {
        INT id PK
        TEXT context
        BOOL applied
        BOOL rejected
    }
    transfer_batch_lines {
        INT batch_id PK
        INT line_no PK
        INT parent_item "raw, no FK"
        NUMERIC amount
        BOOL would_succeed
        TEXT error
    }
    audit_log {
        BIGINT id PK
        BIGINT transaction_id "groups one action"
        TEXT table_name
        TEXT row_key
        JSONB old_row
        JSONB new_row
    }

    storage_unit {
        TEXT barcode PK
        TEXT kind FK
        TEXT stored_in FK "parent unit, NULL = top level"
        INT n_rows "grid, e.g. 8"
        INT n_cols "grid, e.g. 12"
        BOOL discarded
    }
    vessel {
        INT id PK
        TEXT barcode "UNIQUE, tubes only"
        TEXT stored_in FK
        TEXT position "well/slot, e.g. A1"
        NUMERIC max_volume_ul "hard limit"
        BOOL discarded
    }
    items {
        INT id PK
        INT material FK
        INT lot_id FK "bought items only"
        INT in_vessel FK
        NUMERIC quantity
        TEXT unit FK
        TIMESTAMPTZ expires_at
        BOOL in_use
        BOOL reserved
        BOOL in_transit
        BOOL discarded
        BOOL shipped
        BOOL pending_review
    }
    item_lineage {
        INT parent_item PK
        INT child_item PK
        NUMERIC quantity_used "in parent's unit"
        TEXT unit FK
    }
    lots {
        INT id PK
        TEXT supplier "UNIQUE with lot number"
        TEXT supplier_lot_number
        TEXT certificate_of_analysis
        BOOL qc_passed
        BOOL qc_failed
    }
    stock {
        INT id PK
        TEXT description
        INT quantity "count"
        TEXT stored_in FK
    }
    units {
        TEXT code PK
        TEXT dimension "volume, mass, count"
        NUMERIC to_base "to uL, ug, pcs"
    }
    storage_unit_kinds {
        TEXT code PK
        BOOL has_grid
        INT max_children
    }
    materials {
        INT id PK
        TEXT name
    }
